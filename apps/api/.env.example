APP_NAME="SmartBill BD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origin of the Next.js frontend (used for links in emails and redirects).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC
# Local business timezone used for reporting boundaries and subscription periods.
BUSINESS_TIMEZONE=Asia/Dhaka

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartbill
DB_USERNAME=smartbill
DB_PASSWORD=

# Sanctum first-party SPA cookie auth. Frontend and API must share a registrable domain in production.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=smartbill

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Subscriptions ---
# Trial length for new companies. 0 = no trial (company starts in read-only mode until it pays).
SUBSCRIPTION_TRIAL_DAYS=14

# --- bKash Tokenized Checkout (platform's own merchant account) ---
# Credentials come from bKash after merchant onboarding. NEVER commit real values.
# Endpoint paths are configurable in config/bkash.php and MUST be confirmed against the
# official API documentation supplied with your merchant account before go-live.
# "simulator" (local only, NOT bKash) or "bkash".
SUBSCRIPTION_PAYMENT_GATEWAY=simulator
BKASH_ENABLED=false
BKASH_ENVIRONMENT=sandbox
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_TIMEOUT_SECONDS=30
